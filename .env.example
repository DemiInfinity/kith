# ── Kith configuration ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env. See docs/setup.md for every step.

# Where the app is reached (used for sign-in redirects and secure cookies).
KITH_PUBLIC_URL=http://localhost:8787
# Public pages for search engines: the welcome page at "/", indexable /parents, /terms, /privacy and
# /setup, a sitemap and llms.txt. Off by default: "/" is the app's own sign-in, those pages are still
# there but marked noindex, and robots.txt turns every crawler away. Leave it off for a family's own
# Kith; only turn it on if you mean this address to be a public website about Kith.
KITH_PUBLIC_SITE=false
# Host port and bind address for docker compose (use 0.0.0.0 behind your own reverse proxy).
KITH_PORT=8787
KITH_BIND=127.0.0.1
KITH_TIMEZONE=Europe/London

# ── Anthropic (bring your own key) ───────────────────────────────────────────────────
# Use your own API key on an API organisation under Anthropic's Commercial Terms
# (see docs/minors-policy.md). Set the monthly spend limit in the Console too.
# Easiest: leave this empty and paste the key into the parent view (Settings › Claude); it's
# stored encrypted with KITH_SECRET_KEY below. A key set there takes priority over this one.
ANTHROPIC_API_KEY=
KITH_MODEL_FULL=claude-sonnet-5-5
KITH_MODEL_LOW=claude-haiku-5-5
KITH_MODEL_SAFETY=claude-haiku-5-5

# ── People and sign-in (OpenID Connect, e.g. Pocket ID) ──────────────────────────────
KITH_OIDC_ISSUER=
KITH_OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only).
KITH_OIDC_CLIENT_SECRET=
KITH_OIDC_LABEL=Pocket ID
# Who gets in. Use any of these (they combine):
#  - OIDC subject ids (Pocket ID: the user's ID) or VERIFIED emails, comma-separated
KITH_CHILD_IDS=
KITH_PARENT_IDS=
#  - groups (Pocket ID sends them with the "groups" scope), e.g. kith-child / kith-parent
KITH_OIDC_CHILD_GROUP=
KITH_OIDC_PARENT_GROUP=
# Pocket ID only marks emails verified if it's set to (EMAILS_VERIFIED or email verification).
# Set true only if you trust your provider's emails; otherwise use IDs or groups.
KITH_OIDC_TRUST_EMAIL=false
# With a client secret: how to send it to the token endpoint, basic or post.
KITH_OIDC_TOKEN_AUTH=basic
# What the child calls the grown-up in the loop, e.g. Mum, Dad, Grandma.
KITH_PARENT_LABEL=Mum
# Optional: the child's first name (otherwise taken from sign-in).
KITH_CHILD_NAME=
# Local testing only: lets anyone pick child/parent without sign-in. Never on a real server.
KITH_DEV_LOGIN=false

# ── Secrets you generate ─────────────────────────────────────────────────────────────
# openssl rand -hex 32
KITH_DESK_TOKEN=
# npm run vapid   (for check-in notifications)
KITH_VAPID_PUBLIC_KEY=
KITH_VAPID_PRIVATE_KEY=
KITH_VAPID_SUBJECT=mailto:you@example.com

# ── Voice (Wyoming protocol) ─────────────────────────────────────────────────────────
# Defaults point at the compose services (start them with --profile voice).
# To use a Piper you already run, set KITH_TTS_HOST/KITH_TTS_PORT to it.
KITH_STT_HOST=whisper
KITH_STT_PORT=10300
KITH_TTS_HOST=piper
KITH_TTS_PORT=10200
KITH_STT_LANGUAGE=en
KITH_WHISPER_MODEL=base-int8
# A few words Whisper hears first, so it spells your companion's name right (use its name if you rename it).
KITH_WHISPER_PROMPT=A chat with Pip, an AI companion.
KITH_PIPER_DEFAULT_VOICE=en_GB-cori-medium
# The voices offered on the Personality screen: Label=piper-voice-name
KITH_VOICES=Wren=en_GB-cori-medium,Robin=en_GB-alan-medium,Fern=en_GB-jenny_dioco-medium

# ── Reports to the grown-up ──────────────────────────────────────────────────────────
# console (logs only) and/or ha-board (Home Assistant "AI board" script), comma-separated.
KITH_REPORTERS=console
KITH_HA_URL=
# A long-lived token from a Home Assistant user made just for Kith.
KITH_HA_TOKEN=
KITH_HA_SERVICE=script.ai_board_post
# Home Assistant devices the companion may check and control for the child (comma-separated entity ids:
# light., switch., scene. and media_player. only). Leave empty for no home controls.
KITH_HA_DEVICES=
KITH_HA_HANDLE=kith
KITH_HA_KIND_NOW=child_now
KITH_HA_KIND_TODAY=child_today
KITH_HA_KIND_FYI=child_fyi

# ── Tokens for parent-approved connections (named in the parent view) ────────────────
KITH_CONN_HA_TOKEN=
KITH_CONN_KIN_TOKEN=
KITH_CONN_JELLYFIN_TOKEN=

# ── Google Drive (optional, the child's own account; see docs/google.md) ──────────────
# Your own OAuth client (Web application). Redirect URI: <KITH_PUBLIC_URL>/auth/google/callback
# Or, instead of your own Google client: the address of a shared Kith Connect helper (connect/README.md).
KITH_GOOGLE_CONNECT_URL=
KITH_GOOGLE_CLIENT_ID=
KITH_GOOGLE_CLIENT_SECRET=
# Optional: the only Google account that may be connected.
KITH_GOOGLE_ACCOUNT=
# Optional, for the Google Picker: a browser API key and the Cloud project number.
KITH_GOOGLE_PICKER_API_KEY=
KITH_GOOGLE_PROJECT_NUMBER=
# Encrypts stored secrets (the API key set in the parent view, Google sign-in tokens): openssl rand -hex 32
KITH_SECRET_KEY=

# ── Pip's browser (optional search key) ────────────────────────────────────────────────
# Without it, the desk browser searches Wikipedia. With it, Brave Search (always SafeSearch strict).
KITH_BRAVE_API_KEY=

# Leave empty: drawing uploads stay off until a child-safety image detector is built in.
KITH_IMAGE_SAFETY_DETECTOR=

# ── Machine size: light or full (all optional) ─────────────────────────────────────────
# Defaults are the "light" profile for a small machine (e.g. 4 threads, 8 GB RAM). For a bigger
# machine, raise these; nothing else changes. See docs/setup.md › "Light and full".
# KITH_MEM_APP=512m
# KITH_NODE_HEAP_MB=384
# KITH_MEM_EGRESS=128m
# KITH_MEM_DESK=768m
# KITH_DESK_SHM=256m
# KITH_MEM_WHISPER=1536m
# KITH_MEM_PIPER=512m
# Hard cap on the desk's files (the parent view can set a lower one):
# KITH_DESK_MAX_GB=5
# The desk's Chromium stops after this many quiet minutes:
# KITH_DESK_BROWSER_IDLE_MINUTES=2
# The Whisper model (KITH_WHISPER_MODEL, above): quick but mishears a lot: tiny-int8 · recommended: base-int8 · most accurate but slow on older machines: small-int8.
# To share a Wyoming server that's already running elsewhere, set KITH_STT_HOST / KITH_TTS_HOST above,
# or set them in the parent view › Settings › Voice.
