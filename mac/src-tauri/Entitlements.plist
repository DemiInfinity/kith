<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Needed once the app is signed with the hardened runtime. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Calendar and Reminders, only used while sharing is switched on in the Kith menu. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <!-- Asking Apple Music or Spotify whether they're playing (music.rs); macOS asks her first. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
