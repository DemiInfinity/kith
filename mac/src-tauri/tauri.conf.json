{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kith",
  "version": "0.1.0",
  "identifier": "app.kith.mac",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Lifestyle",
    "shortDescription": "Kith, your companion from home",
    "copyright": "Kith contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "../../design/icon/icons/desktop/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": null
    }
  }
}
