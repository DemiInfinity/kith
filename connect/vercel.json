{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"connect\" ]; then exit 0; fi; git diff --quiet HEAD^ HEAD -- .",
  "functions": { "api/*.mjs": { "maxDuration": 10 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" }
    ] }
  ]
}
